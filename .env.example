# Copy to .env (gitignored). Never commit real values.
# ERCOT Public API subscription: https://apiexplorer.ercot.com
ERCOT_USERNAME=
ERCOT_PASSWORD=
ERCOT_SUBSCRIPTION_KEY=

# Deployed alternative: Secrets Manager secret holding {"username","password","subscription_key"}.
# ERCOT_SECRET_ID=ercot/public-api

# Lake root: a local directory (default) or s3://<bucket>.
LAKE_ROOT=./data

# Watermarks: local files by default; the Lambda uses DynamoDB.
# STATE_BACKEND=local
# STATE_DIR=./data/state
# STATE_TABLE=ercot-ingest-state
