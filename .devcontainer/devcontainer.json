// Dev container for local VS Code and GitHub Codespaces. Offline by default:
// LAKE_ROOT=./data, STATE_BACKEND=local, no AWS or ERCOT credentials needed for `make check`.
{
  "name": "ercot-pit-lake",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/va-h/devcontainers-features/uv:1": {},
    "ghcr.io/devcontainers/features/terraform:1": { "version": "1.16.1", "tflint": "latest" },
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "containerEnv": {
    "LAKE_ROOT": "./data",
    "STATE_BACKEND": "local",
    "UV_LINK_MODE": "copy"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.mypy-type-checker",
        "hashicorp.terraform",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff", "editor.formatOnSave": true },
        "[terraform]": { "editor.defaultFormatter": "hashicorp.terraform", "editor.formatOnSave": true }
      }
    }
  },
  // Only needed for `live` tests and real ingest; never required for `make check`.
  "secrets": {
    "ERCOT_USERNAME": { "description": "ERCOT Public API username (apiexplorer.ercot.com)" },
    "ERCOT_PASSWORD": { "description": "ERCOT Public API password" },
    "ERCOT_SUBSCRIPTION_KEY": { "description": "ERCOT Public API subscription key" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode"
}
