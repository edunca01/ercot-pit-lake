build/
dist/

# Secrets and local env
.env
.env.*
!.env.example
.envrc
*.pem
*.key

# Local lake (LAKE_ROOT=./data)
/data/

# ERCOT zips are large and not ours to redistribute in bulk; keep trimmed CSV heads only
samples/**/*.zip

# Terraform: deployment-specific values never enter this repo
infra/**/.terraform/
# an example root; a deployment pins its own providers
infra/**/.terraform.lock.hcl
infra/**/*.tfstate*
infra/**/*.tfvars
!infra/**/*.tfvars.example
infra/backend.hcl
# plan files embed variable values (alert email, Slack IDs) in clear text
*.tfplan
tfplan
crash*.log
override.tf
*_override.tf

# OS / editor
.DS_Store
.idea/
.vscode/
